<%@ tag language="java" pageEncoding="UTF-8" %>
<footer class="w-full py-12 px-8 mt-20 bg-zinc-100 dark:bg-zinc-900 font-['Be_Vietnam_Pro'] text-sm leading-relaxed">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-7xl mx-auto">
    <div class="col-span-1 md:col-span-1">
      <span class="text-xl font-bold text-green-800 dark:text-green-400 mb-4 block">The Living Pantry</span>
      <p class="text-zinc-500 dark:text-zinc-400">Transforming surplus into celebration. Join our mission to eliminate food waste in our community.</p>
    </div>
    <div>
      <h4 class="font-bold text-green-900 dark:text-green-500 mb-4 uppercase tracking-widest text-xs">Resources</h4>
      <div class="flex flex-col gap-2">
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">About Us</a>
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">Sustainability Report</a>
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">Rescue Partners</a>
      </div>
    </div>
    <div>
      <h4 class="font-bold text-green-900 dark:text-green-500 mb-4 uppercase tracking-widest text-xs">Support</h4>
      <div class="flex flex-col gap-2">
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">Privacy Policy</a>
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">Contact</a>
        <a class="text-zinc-500 dark:text-zinc-400 hover:text-green-600 dark:hover:text-green-400 underline underline-offset-4 transition-colors" href="#">FAQ</a>
      </div>
    </div>
    <div>
      <h4 class="font-bold text-green-900 dark:text-green-500 mb-4 uppercase tracking-widest text-xs">Newsletter</h4>
      <p class="text-zinc-500 dark:text-zinc-400 mb-4">Get notified of local harvests.</p>
      <div class="flex">
        <input class="bg-white dark:bg-zinc-800 border-none rounded-l-lg py-2 px-3 text-xs w-full focus:ring-1 focus:ring-green-600" placeholder="email@harvest.com" type="email"/>
        <button class="bg-green-800 text-white px-4 py-2 rounded-r-lg text-xs font-bold">Join</button>
      </div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-zinc-200/50 dark:border-zinc-800/50 text-center">
    <p class="text-zinc-500 dark:text-zinc-400">© 2024 The Living Pantry. Honoring every harvest.</p>
  </div>
</footer>
