<%@ tag language="java" pageEncoding="UTF-8" %>
<footer class="w-full py-12 px-8 mt-20 bg-surface-container-high font-body text-sm leading-relaxed">
  <div class="flex flex-col md:flex-row justify-between items-start gap-10 max-w-7xl mx-auto">
    <div>
      <span class="text-xl font-bold italic text-primary mb-3 block font-headline">ResQFood</span>
      <p class="text-secondary max-w-xs">Transformando excedentes en celebración. Únete a nuestra misión de eliminar el desperdicio de alimentos.</p>
    </div>
    <div>
      <h4 class="font-bold text-primary mb-4 uppercase tracking-widest text-xs font-headline">Contacto</h4>
      <a class="text-secondary hover:text-primary transition-colors" href="mailto:resqfood@resqfood.com">resqfood@resqfood.com</a>
    </div>
  </div>
  <div class="max-w-7xl mx-auto mt-10 pt-8 border-t border-outline-variant/30 text-center">
    <p class="text-secondary">&copy; 2026 <span class="italic">ResQFood</span>. Rescatando cada cosecha.</p>
  </div>
</footer>
