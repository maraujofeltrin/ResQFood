<%@ tag language="java" pageEncoding="UTF-8" %>
<footer class="w-full py-12 px-8 mt-20 bg-surface-container-high font-body text-sm leading-relaxed">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-12 max-w-7xl mx-auto">
    <div class="col-span-1 md:col-span-1">
      <span class="text-xl font-bold text-primary mb-4 block font-headline">The Living Pantry</span>
      <p class="text-secondary">Transforming surplus into celebration. Join our mission to eliminate food waste in our community.</p>
    </div>
    <div>
      <h4 class="font-bold text-primary mb-4 uppercase tracking-widest text-xs font-headline">Resources</h4>
      <div class="flex flex-col gap-2">
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">About Us</a>
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">Sustainability Report</a>
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">Rescue Partners</a>
      </div>
    </div>
    <div>
      <h4 class="font-bold text-primary mb-4 uppercase tracking-widest text-xs font-headline">Support</h4>
      <div class="flex flex-col gap-2">
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">Privacy Policy</a>
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">Contact</a>
        <a class="text-secondary hover:text-primary underline underline-offset-4 transition-colors" href="#">FAQ</a>
      </div>
    </div>
    <div>
      <h4 class="font-bold text-primary mb-4 uppercase tracking-widest text-xs font-headline">Newsletter</h4>
      <p class="text-secondary mb-4">Get notified of local harvests.</p>
      <div class="flex">
        <input class="bg-surface-container-lowest border-none rounded-l-lg py-2 px-3 text-xs w-full focus:ring-1 focus:ring-primary" placeholder="email@harvest.com" type="email"/>
        <button class="bg-primary text-on-primary px-4 py-2 rounded-r-lg text-xs font-bold">Join</button>
      </div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto mt-12 pt-8 border-t border-outline-variant/30 text-center">
    <p class="text-secondary">&copy; 2024 The Living Pantry. Honoring every harvest.</p>
  </div>
</footer>
