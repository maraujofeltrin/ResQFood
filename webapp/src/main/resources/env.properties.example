# Copy this file and rename it to env.properties, then fill in your credentials
# NEVER commit env.properties, only this file

# Database credentials
db.url=jdbc:postgresql://localhost/YOUR_DATABASE_NAME
db.username=YOUR_DATABASE_USERNAME
db.password=YOUR_DATABASE_PASSWORD

# Display name for outgoing emails
mail.from-name=ResQFood

# Gmail account used to send emails
mail.username=username@gmail.com

# App Password of Gmail (it is not your normal password)
mail.password=abcdefghijklmnop

# Base URL of the application, used to build the links in the emails
app.base-url=http://localhost:8080